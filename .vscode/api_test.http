@env = dev
@baseUrl = http://127.0.0.1:8000

# Variables aleatorias
@ts = {{$timestamp}}
@email = user{{ts}}@example.com
@name = User {{ts}}
@allowedSlug = allowed-{{ts}}
@allowedDesc = Allowed item {{ts}}
@banSlug = ban-{{ts}}
@banDesc = Banned item {{ts}}

### Health
### @name health
GET {{baseUrl}}/api/v1/health
Accept: application/json

### Echo de variables
### @name echo_vars
GET https://httpbin.org/anything?email={{email}}&allowed={{allowedSlug}}&ban={{banSlug}}

### =============================================================
### Names: Allowlist
### @name list_allowed
GET {{baseUrl}}/api/v1/names/allowlist?q=allowed&offset=0&limit=5
Accept: application/json

### @name create_allowed
POST {{baseUrl}}/api/v1/names/allowlist
Content-Type: application/json
Accept: application/json

{
  "slug": "{{allowedSlug}}",
  "description": "{{allowedDesc}}"
}

### @name get_allowed
GET {{baseUrl}}/api/v1/names/allowlist/slug/{{allowedSlug}}
Accept: application/json

### @name update_allowed
PUT {{baseUrl}}/api/v1/names/allowlist/slug/{{allowedSlug}}
Content-Type: application/json
Accept: application/json

{
  "description": "Allowed item updated {{ts}}"
}

### @name delete_allowed
DELETE {{baseUrl}}/api/v1/names/allowlist/slug/{{allowedSlug}}
Accept: application/json

### @name list_allowed_after
GET {{baseUrl}}/api/v1/names/allowlist?offset=0&limit=10
Accept: application/json

### =============================================================
### Names: Denylist
### @name list_ban
GET {{baseUrl}}/api/v1/names/denylist?q=ban&offset=0&limit=5
Accept: application/json

### @name create_ban
POST {{baseUrl}}/api/v1/names/denylist
Content-Type: application/json
Accept: application/json

{
  "slug": "{{banSlug}}",
  "description": "{{banDesc}}"
}

### @name get_ban
GET {{baseUrl}}/api/v1/names/denylist/slug/{{banSlug}}
Accept: application/json

### @name update_ban
PUT {{baseUrl}}/api/v1/names/denylist/slug/{{banSlug}}
Content-Type: application/json
Accept: application/json

{
  "description": "Banned item updated {{ts}}"
}

### @name delete_ban
DELETE {{baseUrl}}/api/v1/names/denylist/slug/{{banSlug}}
Accept: application/json

### @name list_ban_after
GET {{baseUrl}}/api/v1/names/denylist?offset=0&limit=10
Accept: application/json

### =============================================================
### Importar nombres desde una ruta y borrar carpetas
@importPath = c:\anasinf

### Crea registros en allowed_names con los nombres de carpetas bajo importPath
### @name import_allowed
POST {{baseUrl}}/api/v1/names/import-folders/allowlist
Content-Type: application/json
Accept: application/json

{
  "path": "{{importPath}}"
}

### Crea registros en ban_names con los nombres de carpetas bajo importPath
### @name import_ban
POST {{baseUrl}}/api/v1/names/import-folders/denylist
Content-Type: application/json
Accept: application/json

{
  "path": "{{importPath}}"
}
