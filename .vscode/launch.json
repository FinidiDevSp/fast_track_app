{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "FastAPI: Uvicorn",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": [
				"app.main:app",
				"--reload",
				"--port",
				"8000",
				"--log-level",
				"debug"
			],
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"jinja": true,
			// 👇 Recomendados para un buen DX:
			"justMyCode": true, // Ignora libs externas al hacer step-into
			"console": "integratedTerminal",
			"autoReload": { // VS Code reinyecta el debugger tras reload
				"enable": true
			},
			// 👇 Si usas venv local .venv, te ayuda a encontrarla.
			// En Windows VS Code suele detectarla; si no, añade:
			// "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
			// En macOS/Linux:
			// "python": "${workspaceFolder}/.venv/bin/python"
		}
	],
	"rest-client.environmentVariables": {
		"$shared": {
			"defaultTimeout": 10000
		},
		"dev": {
			"baseUrl": "http://localhost:8000"
		},
		"prod": {
			"baseUrl": "https://tu-dominio.api"
		}
	}
}