{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Develop",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--log-level",
        "debug"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.develop",
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "autoReload": {
        "enable": true
      }
    },
    {
      "name": "FastAPI: Staging",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--log-level",
        "info"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.staging",
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "autoReload": {
        "enable": true
      }
    },
    {
      "name": "FastAPI: Production",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--port",
        "8000",
        "--log-level",
        "warning"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.production",
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "rest-client.environmentVariables": {
    "$shared": {
      "defaultTimeout": 10000
    },
    "dev": {
      "baseUrl": "http://localhost:8000"
    },
    "prod": {
      "baseUrl": "https://tu-dominio.api"
    }
  }
}

